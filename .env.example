# Copy to .env. This file is only read by Docker Compose and must never be committed with secrets.

# Persistent host directory. Spaces are supported because all Compose volume values are quoted.
# The subdirectories mssql, dataprotection, license, nginx/certs and nginx/logs are mounted into containers.
VM_MANAGER_DATA_ROOT=/srv/vmmanager

# Lokal: vmmanager. Beim Kunden: ghcr.io/team-netz-consulting/vmmanager
VM_MANAGER_IMAGE=ghcr.io/team-netz-consulting/vmmanager
VM_MANAGER_IMAGE_TAG=2026.09.10.0640
VM_MANAGER_HTTP_PORT=80
VM_MANAGER_HTTPS_PORT=443
VM_MANAGER_FRONTEND_SUBNET=172.30.0.0/24
NGINX_SERVER_NAME=vmmanager.example.com
TZ=Europe/Berlin


# License Manager. The stable Docker hostname "vmmanager" is used for the hostname device claim.
LICENSE_MANAGER_BASE_URL=https://license.team-netz.net:5181
LICENSE_CUSTOMER_NAME=Example Customer GmbH
LICENSE_MANAGER_ALLOW_INVALID_CERTIFICATE=false

# SQL Server 2022 on Ubuntu. Express is suitable only within its resource and database-size limits.
# For a licensed production edition set MSSQL_PID accordingly.
MSSQL_PID=Express
MSSQL_DATABASE=VMManager
MSSQL_MEMORY_LIMIT_MB=2048
MSSQL_SA_PASSWORD=replace-with-a-long-random-SQL-password
MSSQL_APP_USER=vmmanager
MSSQL_APP_PASSWORD=replace-with-a-different-long-random-SQL-password

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
JWT_ISSUER=VMManager
JWT_AUDIENCE=VMManager

# Used only to create the first SystemOwner. The values can be removed after the first successful start.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Exactly 32 hexadecimal characters. Generate with: openssl rand -hex 16
GUACAMOLE_JSON_SECRET_KEY=replace-with-32-hexadecimal-digits
# Independent router key. Generate with: openssl rand -hex 32
REMOTE_CONSOLE_ROUTING_SECRET_KEY=replace-with-64-hexadecimal-digits
REMOTE_CONSOLE_MAX_CONNECTIONS=200
REMOTE_CONSOLE_RDP_SERVER_LAYOUT=de-de-qwertz
REMOTE_CONSOLE_ENABLED=true
